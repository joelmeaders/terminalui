{
  "name": "@terminal-kit/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Terminal-inspired Lit components for the everyday web.",
  "files": [
    "dist",
    "docs",
    "examples"
  ],
  "sideEffects": [
    "**/*.css",
    "**/components/*",
    "**/index.*",
    "**/terminal.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./themes.css": {
      "types": "./dist/themes.css.d.ts",
      "default": "./dist/themes.css"
    },
    "./typography.css": {
      "types": "./dist/typography.css.d.ts",
      "default": "./dist/typography.css"
    },
    "./terminal.js": {
      "types": "./dist/index.d.ts",
      "import": "./dist/terminal.js"
    },
    "./react": {
      "types": "./dist/adapters/react.d.ts",
      "import": "./dist/adapters/react.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./vue": {
      "types": "./dist/adapters/vue.d.ts",
      "import": "./dist/adapters/vue.js"
    },
    "./angular": {
      "types": "./dist/adapters/angular.d.ts",
      "import": "./dist/adapters/angular.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./vscode.html-custom-data.json": "./dist/vscode.html-custom-data.json",
    "./catalog.json": "./dist/catalog.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:demo": "vite build && node scripts/icon-credits.mjs",
    "build:site": "npm run build:demo && npm run build:storybook && node scripts/site.mjs",
    "storybook": "npm run build && storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build:storybook": "npm run build && storybook build && node scripts/icon-credits.mjs",
    "test": "playwright test",
    "test:a11y": "playwright test tests/accessibility-contrast.spec.ts tests/accessibility-layout.spec.ts tests/forms-accessibility.spec.ts tests/extended-forms.spec.ts tests/multi-select.spec.ts tests/table-filtering.spec.ts tests/calendar.spec.ts tests/date-picker.spec.ts tests/date-range-picker.spec.ts tests/chip.spec.ts tests/extended-navigation.spec.ts tests/tabs-orientation.spec.ts tests/icons-motion.spec.ts tests/modal-scroll.spec.ts tests/overlay-lifecycle.spec.ts tests/toast-countdown.spec.ts tests/spinner-variants.spec.ts tests/meter-variants.spec.ts tests/slots.spec.ts tests/typography.spec.ts tests/appearance-cascade.spec.ts",
    "test:stories": "vitest run --config vitest.config.ts",
    "test:docs": "node scripts/verify-docs.mjs",
    "size": "node scripts/size.mjs",
    "check": "npm run build && npm run format:check && npm run typecheck && npm run test:docs && npm test && npm run test:stories && npm run test:production && npm run size && npm run test:package",
    "preview": "vite preview --host 127.0.0.1",
    "test:production": "npm run build:site && playwright test --config playwright.production.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "metadata": "node scripts/metadata.mjs",
    "icons:demo": "node scripts/icon-samples.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build",
    "test:behavior": "playwright test --grep-invert \"screenshot|visual\""
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@axe-core/playwright": "4.13.0",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@iconify-json/bi": "1.2.7",
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/material-symbols": "1.2.93",
    "@iconify-json/tabler": "1.2.40",
    "@lit/react": "1.0.8",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/web-components-vite": "10.6.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "4.1.11",
    "esbuild": "0.28.2",
    "ionicons": "8.1.0",
    "lucide": "1.47.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "7.8.2",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "vue": "3.5.43"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "customElements": "./dist/custom-elements.json",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@lit/react": "^1.0.8",
    "react": "^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    }
  }
}
